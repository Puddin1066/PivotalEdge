{
  "name": "@pivotaledge/catalyst-markets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lo-inspired clinical-catalyst event study for listed equity/derivatives (Track: catalyst-markets). Not Polymarket.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "ingestion",
    "entity-resolution",
    "event-study",
    "embeddings",
    "agents",
    "orchestration",
    "models",
    "portfolio",
    "backtest",
    "db",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "m1:baseline": "tsx scripts/m1-lo-baseline.ts",
    "m2:corpus": "tsx scripts/m2-event-corpus.ts",
    "m3:representations": "tsx scripts/m3-embeddings-graph.ts",
    "m4:edge": "tsx scripts/m4-edge-rank.ts",
    "m5:forward": "tsx scripts/m5-forward-freeze.ts",
    "pipeline:run": "tsx scripts/run-pipeline.ts",
    "live:scan": "tsx scripts/live-opportunity-scan.ts"
  },
  "dependencies": {
    "@pivotaledge/schemas": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
