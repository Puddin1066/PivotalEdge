{
  "name": "pivotaledge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './tracks/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' --filter './tracks/*' run typecheck && pnpm --filter @pivotaledge/web run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:env": "tsx scripts/validate-env.ts",
    "s1:discover": "tsx scripts/s1-discover-markets.ts",
    "s2:ingest": "tsx scripts/s2-ingest-evidence.ts",
    "s3:extract": "tsx scripts/s3-extract.ts",
    "s3:eval-gold": "tsx scripts/s3-eval-gold.ts",
    "s4:precedent": "tsx scripts/s4-precedent.ts",
    "s5:forecast": "tsx scripts/s5-forecast.ts",
    "s5:holdout": "tsx scripts/s5-holdout.ts",
    "s6:freeze": "tsx scripts/s6-freeze-snapshot.ts",
    "s6:recommend": "tsx scripts/s6-recommend.ts",
    "s8:backtest": "tsx scripts/s8-backtest.ts",
    "s8b:calibration": "tsx scripts/s8b-calibration.ts",
    "s8b:ingest": "tsx scripts/s8b-ingest-fda.ts",
    "retro:validate": "tsx scripts/retro-validate.ts",
    "quotes:snapshot": "tsx scripts/quotes-snapshot.ts",
    "paper:live": "tsx scripts/paper-live.ts",
    "kg:validate": "tsx scripts/kg-validate.ts",
    "kg:enrich": "tsx scripts/kg-enrich.ts",
    "kg:ingest-retrospective": "tsx scripts/kg-ingest-retrospective.ts",
    "kg:score-live": "tsx scripts/kg-score-live.ts",
    "edge:scan": "tsx scripts/edge-scan.ts",
    "edge:enrich": "tsx scripts/edge-enrich.ts",
    "kg:filing-watch": "tsx scripts/kg-filing-watch.ts",
    "kg:backfill-enrich-contract": "tsx scripts/kg-backfill-enrich-contract.ts",
    "kg:build-pe-filing-lag-priors": "tsx scripts/kg-build-pe-filing-lag-priors.ts",
    "kg:holdout": "tsx scripts/kg-holdout.ts",
    "s9:paper": "tsx scripts/s9-paper.ts",
    "readiness:check": "tsx scripts/readiness-check.ts",
    "orchestration:fixture": "tsx scripts/orchestration-run.ts",
    "orchestration:ab-report": "tsx scripts/orchestration-ab-report.ts",
    "catalyst:pipeline": "pnpm --filter @pivotaledge/catalyst-markets pipeline:run",
    "catalyst:live-scan": "pnpm --filter @pivotaledge/catalyst-markets live:scan",
    "catalyst:m1": "pnpm --filter @pivotaledge/catalyst-markets m1:baseline",
    "catalyst:m4": "pnpm --filter @pivotaledge/catalyst-markets m4:edge",
    "web:dev": "pnpm --filter @pivotaledge/web dev",
    "web:build": "pnpm --filter @pivotaledge/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@pivotaledge/adapters": "workspace:*",
    "@pivotaledge/agents": "workspace:*",
    "@pivotaledge/kg": "workspace:*",
    "@pivotaledge/models": "workspace:*",
    "@pivotaledge/schemas": "workspace:*",
    "@pivotaledge/scoring": "workspace:*",
    "@pivotaledge/evals": "workspace:*",
    "@pivotaledge/workflows": "workspace:*",
    "@pivotaledge/orchestration": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  }
}
