# PivotalEdge environment (S0+)
# Copy to .env and fill values. Secrets stay server-side.

# Runtime
NODE_ENV=development

# OpenAI — used from S1+ for Structured Outputs (not required for S0 tests)
OPENAI_API_KEY=

# Database — required when packages/db is wired (S2+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pivotaledge

# Object storage — document vault (S2+)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Polymarket — read-only (S1+)
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
